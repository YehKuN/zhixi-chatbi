# 前端构建 + Nginx 静态托管；/api/ 反向代理到主后端
FROM node:22-alpine AS build

WORKDIR /app

ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

ARG NPM_REGISTRY=https://registry.npmmirror.com

COPY package.json package-lock.json ./
# lockfile 里的 resolved 指向 registry.npmjs.org，国内构建会 ECONNRESET，统一改写为镜像源。
RUN sed -i 's|https://registry.npmjs.org|https://registry.npmmirror.com|g' package-lock.json \
    && npm ci --registry="$NPM_REGISTRY" --no-audit --no-fund \
        --maxsockets=4 --fetch-retries=10 \
        --fetch-retry-mintimeout=2000 --fetch-retry-maxtimeout=120000

COPY apps/web ./apps/web
RUN npm run build

FROM nginx:1.27-alpine

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html

EXPOSE 8080
