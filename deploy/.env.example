# 生产部署配置：复制为 deploy/.env 后填写，禁止提交到 Git。
# compose 会用本文件做变量替换，同时作为 api / datalink 的运行时环境。

# ---------- 部署位置与访问入口 ----------
# 存储根目录必须是宿主机与容器一致的绝对路径。
CHATBI_STORAGE_ROOT=/opt/zhixi/storage
# 未备案期间用公网 IP + 高位端口访问；备案完成后改为 443 并配置证书。
WEB_PORT=18080

# ---------- 主服务 ----------
APP_ENV=production
AUTH_REQUIRED=true
API_WORKERS=1
# 平台管理台凭据：只存在服务器环境变量，不写入代码或前端
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请替换为管理台强密码
ADMIN_TOKEN_TTL_HOURS=12
# 必须是固定值；更换后已有模型密钥无法解密。
SECRET_MASTER_KEY=请替换为至少32位随机字符串
CORS_ORIGINS=http://请填写公网IP:18080
MAX_UPLOAD_MB=100

# ---------- 服务间令牌 ----------
# 主服务与 DataLink 必须一致，建议 openssl rand -base64 32 生成。
DATALINK_SERVICE_TOKEN=请替换为随机令牌

# ---------- 模型 ----------
DEEPSEEK_API_KEY=请填写真实密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=90
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_MAX_OUTPUT_TOKENS=8192

# DataLink 建图模型；留空则复用上面的 DeepSeek 配置。
DATALINK_LLM_MODEL=
DATALINK_LLM_BASE_URL=
DATALINK_LLM_API_KEY=

# ---------- 超时与预算 ----------
QUERY_TIMEOUT_SECONDS=60
RUN_OPENING_TIMEOUT_SECONDS=120
FINAL_ANSWER_TIMEOUT_SECONDS=90
AGENT_MODEL_MAX_OUTPUT_TOKENS=16384
MODEL_CONTEXT_WINDOW_TOKENS=45056
PYTHON_SANDBOX_TIMEOUT_SECONDS=30

# ---------- 可观测性 ----------
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ChatBI
